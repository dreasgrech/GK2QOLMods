<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the dependency manifest into a built mod DLL and verifies one against the installed game (docs/dependency-check.md).
       Run by DependencyManifest.targets after every mod build; `verify` also by tools/check-dist.py and the release scans.
       Mono.Cecil is the game's own copy (BepInEx/core, 0.10.4): the mods hash with that one at run time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath></Reference>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\Shared\DependencyManifest.cs" Link="DependencyManifest.cs" />
  </ItemGroup>
</Project>
