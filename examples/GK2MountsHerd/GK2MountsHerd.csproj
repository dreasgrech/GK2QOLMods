<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test mod (docs/mounts-persistence-tests.md, part J): a second mod keeping its own donkeys alongside the panel's
       and the showcase's, to test per-mod ids, keys, data, GameReady and dormant records. Not shipped. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2MountsHerd</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Your own mod would reference the installed or released GK2Mounts.dll with a HintPath instead. -->
    <ProjectReference Include="..\..\src\GK2Mounts\GK2Mounts.csproj" Private="false" />
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- A test mod: not deployed by default, so normal play doesn't get its keys (L scatters 50 donkeys). Build with
       -p:Deploy=true to put it into the game (only while the game is closed). -->
  <PropertyGroup>
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
