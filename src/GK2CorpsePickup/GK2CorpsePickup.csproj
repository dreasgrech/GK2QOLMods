<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2CorpsePickup</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <!-- The donkey's delivery is a FlowCanvas graph; the patched node's ports are FlowCanvas types. -->
    <Reference Include="FlowCanvas"><HintPath>$(Managed)\FlowCanvas.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NodeCanvas"><HintPath>$(Managed)\NodeCanvas.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ParadoxNotion"><HintPath>$(Managed)\ParadoxNotion.dll</HintPath><Private>false</Private></Reference>
    <!-- The game's notification widgets derive from Odin's SerializedMonoBehaviour (the self-tests read them). -->
    <!-- MovementComponent.StartPath takes an A* Seeker (we pass null); the overload resolution needs the type. -->
    <Reference Include="AstarPathfindingProject"><HintPath>$(Managed)\AstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(Managed)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <!-- Optional at runtime: only FrameworkLink uses it, and only when the framework is installed. -->
    <Reference Include="GK2.Framework"><HintPath>$(FrameworkDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
