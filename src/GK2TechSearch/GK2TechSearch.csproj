<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2TechSearch</AssemblyName>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A release build (-p:ForDist=true) carries no debug directory: the PDB path would bake this machine's user
         folder into the shipped DLL. -->
    <DebugType Condition="'$(ForDist)' == 'true'">none</DebugType>
    <!-- MSB3277 (System.IO.Compression 4.1.3.0 against 4.2.0.0) is the game's own: its Assembly-CSharp is built against
         4.2.0.0, yet it ships 4.0.0.0 in Managed (no 4.2.0.0 exists anywhere), and Mono unifies them at load. The mod
         uses none of it (the same note as in GK2DonkeyAPI.csproj, where it was checked 2026-10-03). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <!-- Optional at runtime: only FrameworkLink uses it, and only when the framework is installed. -->
    <Reference Include="GK2.Framework"><HintPath>$(FrameworkDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <!-- The dependency check: shared sources, Mono.Cecil, and the manifest embedded after every build (docs/dependency-check.md). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DependencyManifest.targets" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
