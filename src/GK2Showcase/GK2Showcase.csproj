<Project Sdk="Microsoft.NET.Sdk">

  <!-- The playable mount built on the GK2 Mounts API (placeholder name until the user picks one). Ships in one zip
       with GK2Mounts.dll, which it needs (hard dependency). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2Showcase</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GK2Mounts\GK2Mounts.csproj" Private="false" />
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
