<Project>
  <!-- The game install every project in this repo builds against, deploys into and tests against. One place:
       change it here, or pass -p:GameDir="..." on the command line. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <Managed>$(GameDir)\GraveyardKeeper2_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <!-- GK2 Mod Framework (third party, MIT, optional at runtime): a compile-time reference only, never shipped.
         A copy in lib/ so builds work with the framework uninstalled and the API we build against is pinned. -->
    <FrameworkDll Condition="'$(FrameworkDll)' == ''">$(MSBuildThisFileDirectory)lib\GK2.Framework\GK2.Framework.dll</FrameworkDll>
    <!-- GK2 Mod Test Bench (a developer's plugin with a repository of its own, never shipped): the mods' in-game tests
         (tools\GK2QOLMods.Tests) are compiled against its DLL as deployed in the game. Build and deploy the bench
         first (in its repository: dotnet build -c Release -p:Deploy=true). -->
    <TestBenchDll Condition="'$(TestBenchDll)' == ''">$(GameDir)\BepInEx\plugins\GK2ModTestBench\GK2ModTestBench.dll</TestBenchDll>
    <!-- The window code (GK2DreasUI, compiled in as sources): the submodule at lib\GK2DreasUI, always, for anything
         that is committed or released. For trying a change of the library in the game before it is committed there,
         pass -p:GK2DreasUIDir="<the library's own checkout>\" (with the closing backslash): that build is for the
         game on this machine only, and the next plain build is the submodule's again. -->
    <GK2DreasUIDir Condition="'$(GK2DreasUIDir)' == ''">$(MSBuildThisFileDirectory)lib\GK2DreasUI\</GK2DreasUIDir>
  </PropertyGroup>
</Project>
